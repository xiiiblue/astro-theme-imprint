---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { countLabel, taxonomyTitle } from '../../i18n';
import { normalizeTerms, sortPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter(post => !post.data.noindex);
  const categories = new Map<string, typeof posts>();
  for (const post of posts) for (const category of normalizeTerms(post.data.categories)) categories.set(category, [...(categories.get(category) ?? []), post]);
  return [...categories].map(([category, entries]) => ({ params: { category }, props: { category, posts: sortPosts(entries) } }));
}
const { category, posts } = Astro.props;
const title = taxonomyTitle('category', category);
---
<BaseLayout title={title}>
  <div class="container">
    <div class="section-heading"><h1>{title}</h1><span>{countLabel(posts.length, 'post', 'posts')}</span></div>
    <PostList posts={posts} />
  </div>
</BaseLayout>
