---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/HomePage.astro';
import { SITE } from '../../config';
import { pageTitle } from '../../i18n';
import { sortPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = sortPosts((await getCollection('posts')).filter(post => !post.data.noindex));
  const total = Math.ceil(posts.length / SITE.pageSize);
  return Array.from({ length: Math.max(total - 1, 0) }, (_, index) => {
    const current = index + 2;
    const start = (current - 1) * SITE.pageSize;
    return {
      params: { page: String(current) },
      props: { posts: posts.slice(start, start + SITE.pageSize), current, total, totalPosts: posts.length },
    };
  });
}

const { posts, current, total, totalPosts } = Astro.props;
---
<BaseLayout title={pageTitle(current)} noindex>
  <HomePage posts={posts} current={current} total={total} totalPosts={totalPosts} />
</BaseLayout>
