---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/HomePage.astro';
import { SITE } from '../config';
import { sortPosts } from '../utils/posts';

const allPosts = sortPosts((await getCollection('posts')).filter(post => !post.data.noindex));
const posts = allPosts.slice(0, SITE.pageSize);
const total = Math.ceil(allPosts.length / SITE.pageSize);
---
<BaseLayout>
  <HomePage posts={posts} current={1} total={total} totalPosts={allPosts.length} />
</BaseLayout>
