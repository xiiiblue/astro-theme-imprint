---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { pathFor } from '../utils/paths';
---
<BaseLayout title={t('notFoundTitle')} canonical={pathFor('404.html')} noindex>
  <div class="container not-found">
    <strong>404</strong><h1>{t('notFoundMessage')}</h1><p><a href={pathFor()}>{t('backHome')}</a></p>
  </div>
</BaseLayout>
