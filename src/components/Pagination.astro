---
import { t } from '../i18n';
import { pathFor } from '../utils/paths';

interface Props { current: number; total: number; base?: string }
const { current, total, base = '' } = Astro.props;
const normalizedBase = base.replace(/^\/+|\/+$/g, '');
const href = (page: number) => pathFor(page === 1 ? normalizedBase : `${normalizedBase}/page/${page}`);
---
{total > 1 && (
  <nav class="pagination" aria-label={t('pagination')}>
    <span>{current > 1 && <a href={href(current - 1)}>← {t('newerPosts')}</a>}</span>
    <span>{current < total && <a href={href(current + 1)}>{t('olderPosts')} →</a>}</span>
  </nav>
)}
