---
import type { Post } from '../utils/posts';
import { excerpt, formatDate, normalizeTerms, postPath } from '../utils/posts';
import { pathFor } from '../utils/paths';
import { readPostLabel, t } from '../i18n';

interface Props { posts: Post[] }
const { posts } = Astro.props;
---
<ol class="post-list">
  {posts.map(post => (
    <li class="post-card">
      <time class="post-date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <div>
        <h2><a href={postPath(post)}>{post.data.title}</a></h2>
        <a class="post-description-link" href={postPath(post)} aria-label={readPostLabel(post.data.title)}>
          <p>{excerpt(post)}</p>
        </a>
        {(post.data.archived || normalizeTerms(post.data.tags).length > 0) && (
          <div class="badges">
            {post.data.archived && <span class="badge archive">{t('archived')}</span>}
            {normalizeTerms(post.data.tags).map(tag => <a class="badge" href={pathFor(`tags/${encodeURIComponent(tag)}`)}>{tag}</a>)}
          </div>
        )}
      </div>
      <span class="post-arrow" aria-hidden="true">→</span>
    </li>
  ))}
</ol>
