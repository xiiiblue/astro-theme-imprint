---
import type { Post } from '../utils/posts';
import { SITE } from '../config';
import { pageTitle, t } from '../i18n';
import PostList from './PostList.astro';
import Pagination from './Pagination.astro';

interface Props { posts: Post[]; current: number; total: number; totalPosts: number }
const { posts, current, total, totalPosts } = Astro.props;
---
<div class="container">
  {current === 1 && (
    <section class="hero">
      <div class="hero-copy">
        <h1>{SITE.hero.title}</h1>
        <p>{SITE.hero.subtitle}</p>
      </div>
      <p class="hero-count"><strong>{totalPosts}</strong><span>{t('posts')}</span></p>
    </section>
  )}
  <div class="section-heading">
    <h1>{current === 1 ? t('recentPosts') : pageTitle(current)}</h1>
  </div>
  <PostList posts={posts} />
  <Pagination current={current} total={total} />
</div>
