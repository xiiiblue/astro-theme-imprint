---
import '../styles/global.css';
import { SITE } from '../config';
import { t } from '../i18n';
import { pathFor } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
}

const {
  title,
  description = SITE.description,
  canonical = Astro.url.pathname,
  noindex = false,
  type = 'website',
} = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonicalUrl = new URL(canonical, SITE.url);
---
<!doctype html>
<html lang={SITE.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={pathFor('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={pathFor('rss.xml')} />
    <link rel="sitemap" href={pathFor('sitemap-index.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const dark = stored === 'dark' || (!stored && matchMedia('(prefers-color-scheme: dark)').matches);
      if (dark) document.documentElement.dataset.theme = 'dark';
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">{t('skipToContent')}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={pathFor()} aria-label={SITE.title}>
          <img class="brand-mark" src={pathFor(SITE.avatar)} width="36" height="36" alt="" />
          <span class="brand-text">{SITE.shortTitle}</span>
        </a>
        <nav class="site-nav" aria-label={t('primaryNavigation')}>
          <a href={pathFor()}>{t('home')}</a>
          <a href={pathFor('archives')}>{t('archives')}</a>
          <a href={pathFor('tags')}>{t('tags')}</a>
          <a href={pathFor('rss.xml')}>{t('rss')}</a>
          <a class="social-link" href={SITE.navigation.github} rel="me external">{t('github')}</a>
          <button class="theme-toggle" type="button" aria-label={t('themeToggle')} title={t('themeToggle')}>◐</button>
        </nav>
      </div>
    </header>
    <main id="content" class="site-main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-copy">
          <span>© {new Date().getFullYear()} {SITE.author}</span>
          <a href={SITE.footer.licenseUrl}>{SITE.footer.licenseName}</a>
        </p>
        <p class="footer-meta">Powered by Astro · Imprint</p>
      </div>
    </footer>
    <script is:inline>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
